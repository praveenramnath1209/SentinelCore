# ==============================================================================
# SentinelCore SecureOps - Master Environment Configuration Template
# Copy this file to .env and configure for your local/production environment
# DO NOT commit the actual .env file containing sensitive credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (Spring Boot)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/secureopsprojectes
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password

JWT_SECRET=ReplaceWithYourSuperSecureJWTSecretKeyAtLeast256BitsLong2026
JWT_EXPIRATION=86400000

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Frontend Configuration (React / Vite)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api
